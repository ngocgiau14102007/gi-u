    <footer class="bg-burgundy text-white py-12 relative overflow-hidden">
        <div class="absolute inset-0 opacity-5 bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
            <div class="w-16 h-16 bg-gold/20 rounded-full flex items-center justify-center mx-auto mb-6 border border-gold/40">
                <i class="fa-solid fa-ring text-gold text-2xl"></i>
            </div>
            <h2 class="font-serif text-3xl md:text-4xl font-bold mb-3 text-gold">Nông Thu Huyền & Nguyễn Văn Trường</h2>
