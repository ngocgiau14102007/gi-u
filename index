    <!-- RSVP SECTION -->
    <section id="rsvp" class="py-20 bg-cream-dark relative">
        <div class="max-w-4xl mx-auto px-4">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-gold font-semibold tracking-widest uppercase text-xs">XÁC NHẬN & CHÚC PHÚC</span>
                <h2 class="font-serif text-4xl md:text-5xl font-bold text-burgundy mt-2 mb-4">Sổ Lưu Bút Hạnh Phúc</h2>
                <div class="w-16 h-0.5 bg-gold mx-auto"></div>
                <p class="text-gray-600 mt-4 text-sm">Gửi lời chúc mừng đến cô dâu chú rể và xác nhận tham dự đám cưới.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <div class="glass-card rounded-3xl p-8 shadow-xl border border-gold/30">
                    <h3 class="font-serif text-2xl font-bold text-burgundy mb-6 flex items-center">
                        <i class="fa-solid fa-pen-nib text-gold mr-3"></i> Gửi Lời Chúc & Xác Nhận
                    </h3>
                    
                    <form id="rsvp-form" onsubmit="handleRSVP(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-700 mb-1">Họ và tên quý khách *</label>
                            <input type="text" id="guest-name" required placeholder="Ví dụ: Nguyễn Văn A" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-burgundy bg-white text-sm">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-700 mb-1">Trạng thái tham dự *</label>
                            <select id="guest-attendance" class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-burgundy bg-white text-sm">
                                <option value="Chắc chắn sẽ tham dự 🎉">Chắc chắn sẽ tham dự 🎉</option>
                                <option value="Rất tiếc, không thể tham dự 💌">Rất tiếc, không thể tham dự 💌</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold uppercase text-gray-700 mb-1">Lời chúc phúc *</label>
                            <textarea id="guest-message" required rows="4" placeholder="Gửi lời chúc tốt đẹp nhất đến cô dâu & chú rể..." class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:border-burgundy bg-white text-sm"></textarea>
                        </div>

                        <button type="submit" class="w-full py-4 bg-burgundy hover:bg-burgundy-light text-white font-semibold rounded-xl shadow-lg transition duration-300 flex items-center justify-center space-x-2">
